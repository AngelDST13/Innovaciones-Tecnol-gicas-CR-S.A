# Copia este archivo a backend/.env y completa los valores.
# backend/.env contiene secretos: nunca lo subas al repositorio.

PORT=8000
NODE_ENV=development

# Supabase > Project Settings > Database > Connection string (modo URI, puerto 5432).
# Si la contraseña tiene caracteres especiales, codifícalos (p. ej. @ -> %40).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Verificación del certificado TLS de Supabase. Ponlo en true solo si tienes el certificado CA configurado.
DB_SSL_REJECT_UNAUTHORIZED=false

# DeepSeek (API compatible con OpenAI)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=30000

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Umbral (ms) a partir del cual la latencia se registra como advertencia
LATENCY_WARNING_MS=3000

# Reporte diario automático a las 7:00 a. m. (hora de Costa Rica). false lo desactiva.
REPORTE_AUTOMATICO=true

# Google Drive (fuente de políticas). La llave JSON va fuera del repositorio, en la carpeta secrets/.
GOOGLE_APPLICATION_CREDENTIALS=../secrets/gcp-drive-sa.json
DRIVE_FOLDER_ID=
GCP_PROJECT_ID=innovaciones-cr-mp2

# Supabase (API). La clave service_role va solo en backend/.env, nunca en el repositorio.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
